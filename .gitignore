# Persona synthesis generated artifacts
# Keep graph/schema/source files and markdown reports in git, but do not commit
# large generated persona matrices, code shards, rendered samples, or analytics
# exports. Regenerate these from persona/synthesis/scripts instead.
persona/synthesis/reports/**/*.codes
persona/synthesis/reports/**/*.codes.gz
persona/synthesis/reports/**/*.codes.schema.json
persona/synthesis/reports/**/*.codes.gz.schema.json
persona/synthesis/reports/**/*.npy
persona/synthesis/reports/**/*.npz
persona/synthesis/reports/**/*.parquet
persona/synthesis/reports/**/*.jsonl
persona/synthesis/reports/**/*.csv
persona/synthesis/reports/**/tmp/
persona/synthesis/reports/**/rendered_*.jsonl
persona/synthesis/reports/**/shard_*
persona/synthesis/generated/
persona/synthesis/jobs/**/sbatch_logs/

# Persona post-processing generated datasets and scheduler artifacts
persona/post_process/coreset_1m/results/
persona/post_process/unified_dataset/results/
persona/post_process/**/jobs/manifests/
persona/post_process/**/jobs/sbatch_logs/
/sbatch_logs/

# PersonaBench migration outputs and large generated Persona artifacts.
persona/curation/attribute_pool/outputs/
persona/curation/attribute_pool/sources/acs_pums/*.csv
persona/curation/attribute_pool/sources/raw/
# Generated synthetic pools (bench-dev-2000, etc.). Checked-in fixture is
# persona/datasets/matraix-persona-dev-sample/ (not matched by this pattern).
persona/datasets/bench-dev-*/
persona/datasets/_generated/
# Launch caches next to a source dataset (dev sample, saved datasets, …).
persona/datasets/*/cohorts/
# Production 1M release mirror + sampled cohorts (large / machine-local).
persona/datasets/matraix-persona-1m/release/
persona/datasets/matraix-persona-1m/cohorts/
persona/datasets/matraix-persona-1m/indexes/
configs/jobs/application-task-job-recipe/*.yaml
configs/jobs/application-task-job-recipe/*.meta.json
configs/jobs/application-task-job-recipe/*.launch.json
!configs/jobs/application-task-job-recipe/appSim-example-survey-product-feedback-random-n4.yaml
!configs/jobs/application-task-job-recipe/appSim-example-survey-product-feedback-random-n4.meta.json
configs/jobs/persona-job-recipe/*.yaml
configs/jobs/persona-job-recipe/*.meta.json
configs/jobs/persona-job-recipe/*.launch.json

# Local Harbor job outputs (recipes live under configs/jobs/)
/jobs/*
# Grounding eval handoff: keep model job trees, drop screen recordings (>100MB).
!/jobs/gpt55/
!/jobs/gpt55/**
!/jobs/opus/
!/jobs/opus/**
/jobs/**/*.mp4
/jobs/**/recording.mp4

