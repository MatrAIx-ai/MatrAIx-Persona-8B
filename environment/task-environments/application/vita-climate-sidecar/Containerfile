FROM python:3.12-slim-bookworm

WORKDIR /app

COPY .cache/vita-climate-sidecar/vendor /usr/local/lib/python3.12/site-packages

COPY src/matraix/__init__.py /app/matraix/__init__.py
COPY src/matraix/vita /app/matraix/vita

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "matraix.vita.api:app", "--host", "0.0.0.0", "--port", "8000"]
