{% macro localized(language, key, fallback='') -%}
{%- set copy = COPY.get(language, COPY['en']) -%}
{{ copy.get(key, COPY['en'].get(key, fallback or key)) }}
{%- endmacro %}

{% macro render_identity(display_name, language='en') -%}
{% if display_name %}{{ localized(language, 'youAre') }}{{ display_name }}{{ localized(language, 'youAreSuffix') }}{% endif -%}
{%- endmacro %}

{% macro render_persona_narrative(paragraphs, language='en') -%}
{% if paragraphs %}
## {{ localized(language, 'who') }}

{% for paragraph in paragraphs -%}
{{ paragraph }}

{% endfor -%}
{% endif -%}
{% endmacro %}

{% macro render_demographics(d, language='en') -%}
{% if d %}
## {{ localized(language, 'demographics') }}
{% if d.age is defined %}- {{ localized(language, 'age') }}: {{ d.age }}
{% endif -%}
{% if d.gender is defined %}- {{ localized(language, 'gender') }}: {{ d.gender }}
{% endif -%}
{% if d.location is defined %}- {{ localized(language, 'location') }}: {{ d.location }}
{% endif -%}
{% if d.occupation is defined %}- {{ localized(language, 'occupation') }}: {{ d.occupation }}
{% endif -%}
{% if d.education is defined %}- {{ localized(language, 'education') }}: {{ d.education }}
{% endif -%}
{% if d.income_bracket is defined %}- {{ localized(language, 'income') }}: {{ d.income_bracket }}
{% endif -%}
{% if d.life_stage is defined %}- {{ localized(language, 'lifeStage') }}: {{ d.life_stage }}
{% endif -%}
{% if d.cultural_background is defined %}- {{ localized(language, 'background') }}: {{ d.cultural_background }}
{% endif -%}
{% endif -%}
{% endmacro %}

{% macro render_psychology(p, language='en') -%}
{% if p %}
## {{ localized(language, 'psychology') }}
{% if p.big_five is defined and p.big_five %}
- {{ localized(language, 'bigFive') }}: openness={{ p.big_five.openness }}, conscientiousness={{ p.big_five.conscientiousness }}, extraversion={{ p.big_five.extraversion }}, agreeableness={{ p.big_five.agreeableness }}, neuroticism={{ p.big_five.neuroticism }}
{% endif -%}
{% if p.risk_tolerance is defined %}- {{ localized(language, 'riskTolerance') }}: {{ p.risk_tolerance }}
{% endif -%}
{% if p.openness_to_new_tools is defined %}- {{ localized(language, 'opennessToNewTools') }}: {{ p.openness_to_new_tools }}
{% endif -%}
{% if p.patience is defined %}- {{ localized(language, 'patience') }}: {{ p.patience }}
{% endif -%}
{% if p.skepticism is defined %}- {{ localized(language, 'skepticism') }}: {{ p.skepticism }}
{% endif -%}
{% if p.motivation_drivers is defined and p.motivation_drivers %}
- {{ localized(language, 'motivation') }}: {{ p.motivation_drivers | join(', ') }}
{% endif -%}
{% if 'values' in p and p['values'] %}
- {{ localized(language, 'values') }}: {{ p['values'] | join(', ') }}
{% endif -%}
{% endif -%}
{% endmacro %}

{% macro render_communication(c, language='en') -%}
{% if c %}
## {{ localized(language, 'communication') }}
{% if c.tone is defined %}- {{ localized(language, 'tone') }}: {{ c.tone }}
{% endif -%}
{% if c.verbosity is defined %}- {{ localized(language, 'verbosity') }}: {{ c.verbosity }}
{% endif -%}
{% if c.formality is defined %}- {{ localized(language, 'formality') }}: {{ c.formality }}
{% endif -%}
{% if c.language_level is defined %}- {{ localized(language, 'language') }}: {{ c.language_level }}
{% endif -%}
{% if c.technical_fluency is defined %}- {{ localized(language, 'technicalFluency') }}: {{ c.technical_fluency }}
{% endif -%}
{% if c.attention_span is defined %}- {{ localized(language, 'attentionSpan') }}: {{ c.attention_span }}
{% endif -%}
{% if c.learning_style is defined %}- {{ localized(language, 'learningStyle') }}: {{ c.learning_style }}
{% endif -%}
{% endif -%}
{% endmacro %}

{% macro render_preferences(p, language='en') -%}
{% if p %}
## {{ localized(language, 'preferences') }}
{% if p.hobbies is defined and p.hobbies %}
- {{ localized(language, 'hobbies') }}: {{ p.hobbies | join(', ') }}
{% endif -%}
{% if p.brand_affinities is defined and p.brand_affinities %}
- {{ localized(language, 'brands') }}: {{ p.brand_affinities | join(', ') }}
{% endif -%}
{% if p.price_sensitivity is defined %}- {{ localized(language, 'priceSensitivity') }}: {{ p.price_sensitivity }}
{% endif -%}
{% if p.aesthetic_taste is defined %}- {{ localized(language, 'aesthetic') }}: {{ p.aesthetic_taste }}
{% endif -%}
{% endif -%}
{% endmacro %}

{% macro render_behavior(b, language='en') -%}
{% if b %}
## {{ localized(language, 'behavior') }}
{% for key, value in b.items() %}
- {{ localized(language, key, key | replace('_', ' ') | title) }}: {% if value is iterable and value is not string %}{{ value | join(', ') }}{% else %}{{ value }}{% endif %}
{% endfor -%}
{% endif -%}
{% endmacro %}

{% macro render_domains(demographics, psychology, communication, preferences, behavior, language='en') -%}
{{ render_demographics(demographics, language=language) }}
{{ render_psychology(psychology, language=language) }}
{{ render_communication(communication, language=language) }}
{{ render_preferences(preferences, language=language) }}
{{ render_behavior(behavior, language=language) }}
{% endmacro %}

{% macro render_v0_identity(display_name, summary, system_prompt, language='en') -%}
{{ render_identity(display_name, language=language) }}
{% if summary %}

{% if language != 'en' %}## {{ localized(language, 'profile') }}
{% endif -%}
{{ summary }}
{% endif -%}
{% if system_prompt %}

{% if language != 'en' %}## {{ localized(language, 'guidance') }}
{% endif -%}
{{ system_prompt }}
{% endif -%}
{% endmacro %}
